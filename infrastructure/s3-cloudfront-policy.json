{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowCloudFrontReadOnly",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::king-comics-jacobuid/comics/*",
        "arn:aws:s3:::king-comics-jacobuid/generated/*"
      ],
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::853931232796:distribution/E3C2G8VW4ZZM4W"
        }
      }
    }
  ]
}
